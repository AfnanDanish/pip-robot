<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pip_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch for Pip: simulation, navigation, autonomy, personality and RViz.</description>
  <maintainer email="pip-robot@users.noreply.github.com">Afnan Ali Danish</maintainer>
  <license>MIT</license>

  <exec_depend>pip_brain</exec_depend>
  <exec_depend>pip_description</exec_depend>
