<?xml version="1.0"?>
<!--
  A small apartment for Pip: living room (east), bedroom (north-west), kitchen (south-west).
  Interior spans x -4..4, y -3..3 (metres). The charging dock sits against the east wall at y = -1.
  Pip spawns docked: base centre at (3.77, -1.0), facing +x into the dock.
-->
<sdf version="1.9">
  <world name="apartment">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.78 0.82 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8.2 6.2</size></plane></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- Outer walls -->
        <collision name="north_c"><pose>0 3.05 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1.0</size></box></geometry></collision>
        <visual name="north_v"><pose>0 3.05 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1.0</size></box></geometry><material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -3.05 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1.0</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -3.05 0.5 0 0 0</pose><geometry><box><size>8.2 0.1 1.0</size></box></geometry><material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material></visual>
        <collision name="west_c"><pose>-4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6.0 1.0</size></box></geometry></collision>
        <visual name="west_v"><pose>-4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6.0 1.0</size></box></geometry><material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material></visual>
        <collision name="east_c"><pose>4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6.0 1.0</size></box></geometry></collision>
        <visual name="east_v"><pose>4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6.0 1.0</size></box></geometry><material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material></visual>
        <!-- Wall between living room and the west rooms, with two doorways (y -1.9..-1.0 and 1.0..1.9) -->
        <collision name="mid_s_c"><pose>0 -2.45 0.5 0 0 0</pose><geometry><box><size>0.1 1.1 1.0</size></box></geometry></collision>
        <visual name="mid_s_v"><pose>0 -2.45 0.5 0 0 0</pose><geometry><box><size>0.1 1.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="mid_c_c"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.1 2.0 1.0</size></box></geometry></collision>
        <visual name="mid_c_v"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.1 2.0 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="mid_n_c"><pose>0 2.45 0.5 0 0 0</pose><geometry><box><size>0.1 1.1 1.0</size></box></geometry></collision>
        <visual name="mid_n_v"><pose>0 2.45 0.5 0 0 0</pose><geometry><box><size>0.1 1.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <!-- Wall between bedroom and kitchen, doorway at x -2.45..-1.55 -->
        <collision name="hall_w_c"><pose>-3.225 0 0.5 0 0 0</pose><geometry><box><size>1.55 0.1 1.0</size></box></geometry></collision>
        <visual name="hall_w_v"><pose>-3.225 0 0.5 0 0 0</pose><geometry><box><size>1.55 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
        <collision name="hall_e_c"><pose>-0.8 0 0.5 0 0 0</pose><geometry><box><size>1.5 0.1 1.0</size></box></geometry></collision>
        <visual name="hall_e_v"><pose>-0.8 0 0.5 0 0 0</pose><geometry><box><size>1.5 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bedroom -->
    <model name="bed">
      <static>true</static>
      <pose>-3.25 1.95 0.225 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.4 2.0 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.4 2.0 0.45</size></box></geometry><material><ambient>0.35 0.45 0.7 1</ambient><diffuse>0.35 0.45 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wardrobe">
      <static>true</static>
      <pose>-0.6 2.7 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.5 1.2</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Kitchen -->
    <model name="counter">
      <static>true</static>
      <pose>-2.2 -2.65 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.6 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.6 0.6 0.9</size></box></geometry><material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <model name="kitchen_table">
      <static>true</static>
      <pose>-2.0 -1.2 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.9 0.7 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.9 0.7 0.75</size></box></geometry><material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Living room -->
    <model name="couch">
      <static>true</static>
      <pose>2.6 2.55 0.225 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.8 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.8 0.45</size></box></geometry><material><ambient>0.3 0.55 0.45 1</ambient><diffuse>0.3 0.55 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="coffee_table">
      <static>true</static>
      <pose>2.6 1.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.9 0.5 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.9 0.5 0.4</size></box></geometry><material><ambient>0.5 0.35 0.22 1</ambient><diffuse>0.5 0.35 0.22 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tv_stand">
      <static>true</static>
      <pose>0.3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 1.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.4 0.5</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
      </link>
    </model>
    <model name="armchair">
      <static>true</static>
      <pose>1.2 -2.4 0.225 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.45</size></box></geometry><material><ambient>0.7 0.35 0.3 1</ambient><diffuse>0.7 0.35 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="plant">
      <static>true</static>
      <pose>3.65 -2.65 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.2 0.55 0.25 1</ambient><diffuse>0.2 0.55 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Charging dock: 0.12 deep, 0.30 wide, 0.25 tall. Front face at x = 3.88. -->
    <model name="dock">
      <static>true</static>
      <pose>3.94 -1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><pose>0 0 0.125 0 0 0</pose><geometry><box><size>0.12 0.30 0.25</size></box></geometry></collision>
        <visual name="body"><pose>0 0 0.125 0 0 0</pose><geometry><box><size>0.12 0.30 0.25</size></box></geometry><material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual>
        <visual name="light"><pose>-0.061 0 0.2 0 0 0</pose><geometry><box><size>0.002 0.2 0.025</size></box></geometry><material><ambient>1 0.6 0.15 1</ambient><diffuse>1 0.6 0.15 1</diffuse><emissive>1 0.55 0.1 1</emissive></material></visual>
        <visual name="contact_l"><pose>-0.061 0.05 0.045 0 0 0</pose><geometry><box><size>0.004 0.03 0.015</size></box></geometry><material><ambient>0.85 0.72 0.3 1</ambient><diffuse>0.85 0.72 0.3 1</diffuse></material></visual>
        <visual name="contact_r"><pose>-0.061 -0.05 0.045 0 0 0</pose><geometry><box><size>0.004 0.03 0.015</size></box></geometry><material><ambient>0.85 0.72 0.3 1</ambient><diffuse>0.85 0.72 0.3 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
